# Smart Parking CRM Frontend v2 Environment Configuration

# 1. API Base URL - Chế độ kết nối Backend
# Local Docker API Gateway (Đang chạy tại máy): http://localhost:8088
VITE_API_BASE_URL=http://localhost:8088

# VPS Backend (Bỏ comment khi cần chuyển sang nối server VPS từ xa):
# VITE_API_BASE_URL=

VITE_APP_ENV=development

# Map Configuration — MapLibre GL JS + Google Maps Đường phố (default) + OpenFreeMap fallback + OSRM Routing
# Basemap options: google-roadmap | openfreemap (can also be overridden at runtime via /map-config.json)
VITE_MAP_DEFAULT_BASEMAP=google-roadmap
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
VITE_MAP_PHOTON_URL=https://photon.komoot.io/api/
VITE_MAP_GEOCODER_ENABLED=true
VITE_MAP_OSRM_URL=https://router.project-osrm.org
VITE_MAP_ROUTING_ENABLED=true

# Client Application Security Key
VITE_APP_KEY=SP_APP_KEY_2026_xM99qP2!
