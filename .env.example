# Smart Parking CRM Frontend v2 Environment Configuration

# 1. API Base URL - Chế độ kết nối Backend
# Local Docker API Gateway (Đang chạy tại máy): http://localhost:8088
VITE_API_BASE_URL=http://localhost:8088

# VPS Backend (Bỏ comment khi cần chuyển sang nối server VPS từ xa):
# VITE_API_BASE_URL=

VITE_APP_ENV=development

# OpenStreetMap XYZ endpoint; can point to an organization-hosted OSM tile server.
VITE_OSM_TILE_URL=

# Client Application Security Key
VITE_APP_KEY=
