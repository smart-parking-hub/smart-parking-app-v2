# Smart Parking CRM Frontend v2 Environment Configuration

# 1. API Base URL - Chế độ kết nối Backend
# Local Docker API Gateway (Đang chạy tại máy): http://localhost:8088
VITE_API_BASE_URL=http://localhost:8088

# VPS Backend (Bỏ comment khi cần chuyển sang nối server VPS từ xa):
# VITE_API_BASE_URL=

VITE_APP_ENV=development

# Google Maps JavaScript API (Browser key - restrict by HTTP referrer & enabled APIs)
# Required APIs: Maps JavaScript API, Places API (New), Routes API
VITE_GOOGLE_MAPS_API_KEY=
# Map ID for Advanced Markers (create in Google Cloud Console -> Google Maps Platform -> Map Management)
VITE_GOOGLE_MAPS_MAP_ID=

# OpenStreetMap XYZ endpoint (deprecated - kept temporarily until P5 cleanup)
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Client Application Security Key
VITE_APP_KEY=SP_APP_KEY_2026_xM99qP2!
